# Docker Compose configuration. Copy to `.env` and edit.  NEVER commit `.env`.

# --- Required ---------------------------------------------------------
# Shared by backend (signing) and frontend (edge verification). >= 16 chars.
# Generate: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string

# --- Public URLs (as seen by the browser; baked into frontend/admin at build) ---
PUBLIC_API_URL=http://localhost:7171
PUBLIC_SOCKET_URL=http://localhost:8181
SITE_NAME=Qwlee
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:4000

# Frontend images are served unoptimised by default (works behind proxies
# and avoids server-side fetching). Set to true at build time to enable
# Next.js image optimisation.
# NEXT_IMAGE_OPTIMIZE=false

# --- Host ports -------------------------------------------------------
BACKEND_PORT=7171
SOCKET_PORT=8181
FRONTEND_PORT=8000
ADMIN_PORT=4000

# Swagger UI at /v1/docs (always on when NODE_ENV=development)
# ENABLE_API_DOCS=true
# Platform commission on completed orders, percent (admin can override)
# PLATFORM_FEE_PERCENT=5
# Demo checkout without Stripe keys; set false in production
# DEMO_PAYMENTS=true
# AUTO_COMPLETE_DAYS=3
# ORDER_HOUSEKEEPING_MS=600000
# REQUEST_TTL_DAYS=14
# Hours to answer a mutual cancellation request before it is auto-accepted
# CANCEL_RESPONSE_HOURS=48
# Price per day for a promoted gig, in dollars.
# PROMO_DAY_PRICE=5
# Display currencies (prices are charged in USD).
# FX_RATES_URL=https://open.er-api.com/v6/latest/USD
# CURRENCIES=USD,EUR,GBP,BDT
# Mailpit web UI port (bundled local email inbox)
MAILPIT_PORT=8025

# --- Optional integrations (leave commented out to disable) -----------
# Image uploads (https://api.imgbb.com/)
# IMGBB_API_KEY=
# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Google sign-in (https://console.cloud.google.com/apis/credentials).
# The "Continue with Google" button is hidden unless both are set.
# Authorised redirect URI: <PUBLIC_API_URL>/v1/auth/google/callback
# Browser (Web Push) notifications. Generate keys once with:
#   docker compose exec backend npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Push services the API may deliver to (default: Chrome/FCM, Firefox, Safari, Edge)
# PUSH_ENDPOINT_HOSTS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # optional override of the redirect URI above
# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# SMTP (emails for OTP / password reset). Defaults to the bundled Mailpit.
# Do not set these to empty values.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
