# ---------------------------------------------------------------
# Backend environment variables. Copy this file to `.env` and fill
# in real values. Never commit `.env`.
# ---------------------------------------------------------------

# Server
NODE_ENV=development
PORT=7171
# Interface the HTTP server binds to. Leave blank for default (all
# interfaces). In production set to the public IP or 127.0.0.1
# behind a reverse proxy.
BACKEND_IP=

# Database
MONGODB_URL=mongodb://localhost:27017/cnnctr

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Frontend URL — used for Stripe success/cancel redirects.
FRONTEND_URL=http://localhost:8000

# CORS — comma-separated list of allowed origins for the API.
# Example: https://qwlee.com,https://admin.qwlee.com,http://localhost:8000,http://localhost:4000
CORS_ORIGINS=http://localhost:8000,http://localhost:4000

# Cloudinary — https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — for real outbound mail set host/port/user/pass/from (not Mailpit).
# Aliases: SMTP_USER=SMTP_USERNAME, SMTP_PASS=SMTP_PASSWORD, SMTP_FROM=EMAIL_FROM.
# Local demo can keep SMTP_HOST=127.0.0.1 and SMTP_PORT=1025 (Mailpit).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@qwlee.com
SMTP_FROM=
EMAIL_FROM=

# Payments — for live card charges set all three Stripe vars, then DEMO_PAYMENTS=false.
# Leave DEMO_PAYMENTS=true for local demos without Stripe (orders are free/demo).
# Do NOT set DEMO_PAYMENTS=false until STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET exist.
DEMO_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# ImgBB — https://api.imgbb.com/ (free tier). All image uploads route here.
IMGBB_API_KEY=
MAX_IMAGE_SIZE_MB=32

# Opt-in AI helpers (/ai-assistant). off disables them. Without a provider a
# deterministic mock is used. AI_API_URL is an OpenAI-compatible chat endpoint.
AI_HELPERS=on
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Meeting host for calls scheduled inside orders (demo default: Jitsi room links).
MEETING_BASE_URL=https://meet.jit.si

# Dispute AI assistant (OpenRouter by default — OpenAI-compatible).
# Free default model; for better quality use openai/gpt-4o-mini (paid).
AI_DISPUTE_ASSISTANT=on
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_DISPUTE_URL=http://ai-dispute:7190
AI_DISPUTE_TOKEN=local-ai-dispute-token-change-me
OPENROUTER_HTTP_REFERER=https://qwlee.local
OPENROUTER_X_TITLE=Qwlee Dispute Assistant
